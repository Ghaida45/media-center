model ContentItem {
  id              String    @id @default(uuid())
  titleEn         String
  titleAr         String
  type            String
  status          String
  category        String[]
  date            TimestamptzString
  expiryDate      TimestamptzString?
  bodyEn          String
  bodyAr          String
  rejectionReason String?
  sender          String
  sentDate        TimestamptzString
}